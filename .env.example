# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (required) ---
# Prisma's MySQL connection string. See README.md for local setup via Docker.
DATABASE_URL="mysql://user:password@localhost:3306/learnloom"
# Prisma requires a separate shadow DB for generating migrations (not used at runtime).
SHADOW_DATABASE_URL="mysql://user:password@localhost:3307/prisma_shadow"

# --- AI features (optional) ---
# Powers /api/ai/quiz and /api/ai/feedback. Leave AI_QUIZ_ENABLED unset/false to
# disable AI quiz generation entirely (the static 18-quiz/180-question bank still works).
OPENAI_API_KEY=""
AI_QUIZ_ENABLED="false"
AI_QUIZ_MODEL="gpt-4o-mini"

# --- Translation lookups (optional, used by Reading Pal word lookups) ---
LIBRE_TRANSLATE_URL=""
LIBRE_TRANSLATE_KEY=""

# --- Admin/support tool (required to use /admin) ---
# Password for the internal support login at /admin/login. Use a long random value.
SUPPORT_PASS=""

# --- Rate limiting for anonymous-code login (optional, has defaults in code) ---
ENABLE_CODE_RATELIMIT="true"
CODE_RATE_LIMIT="5"
CODE_RATE_MAX="5"
CODE_RATE_WINDOW_MS="60000"
CODE_RATE_BLOCK_MS="300000"
